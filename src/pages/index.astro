---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cabinet from '../design/Cabinet.astro';
import GameTile from '../design/GameTile.astro';
import ArcadeButton from '../design/ArcadeButton.astro';
import AdSlot from '../design/AdSlot.astro';
import { floorGames } from '../games/registry';
import { SITE_NAME } from '../config/site';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p.replace(/^\//, '')}`;

const featured = floorGames.find((g) => g.featured) ?? floorGames[0]!;
const rest = floorGames.filter((g) => g !== featured);
const daily = floorGames.find((g) => g.meta.daily);

const litCount = floorGames.filter((g) => g.status === 'playable').length;
const soonCount = floorGames.length - litCount;
const floorIntro =
  soonCount > 0
    ? `${litCount} cabinets are lit and playable; ${soonCount} more ${soonCount === 1 ? 'is' : 'are'} warming up.`
    : `All ${floorGames.length} cabinets are lit. Pick one and play.`;
---

<BaseLayout>
  <!-- Hero: the attract-mode cabinet + the daily panel -->
  <section class="hero container">
    <div class="hero__cabinet">
      <Cabinet title={featured.meta.title} color={featured.color} as="h1" aspect="16 / 10">
        <div class="hero__screen">
          <p class="hero__pitch">{featured.meta.tagline}</p>
          <p class="hero__note">Live gameplay previews land soon. For now, pick a cabinet.</p>
        </div>
        <Fragment slot="controls">
          <ArcadeButton variant="primary" size="lg" icon="play" href={href(`games/${featured.meta.slug}`)}>
            Play {featured.meta.title}
          </ArcadeButton>
          <span class="hero__meta">{featured.meta.category}</span>
        </Fragment>
      </Cabinet>
    </div>

    {
      daily && (
        <aside class="daily carpet" data-daily-panel>
          <h2 class="daily__title">Today's {daily.meta.title}</h2>
          <p class="daily__sub">
            <span data-rungs-number>Puzzle</span> · one climb a day, the same for everyone
          </p>
          <ArcadeButton variant="secondary" href={href(`games/${daily.meta.slug}`)}>
            <span data-rungs-cta>Play today's</span>
          </ArcadeButton>
          <p class="daily__streak">
            Your streak <span class="daily__streak-num" data-rungs-streak>0</span>
          </p>
        </aside>
      )
    }
  </section>

  <div class="container">
    <AdSlot placement="homepage-between" width={728} height={90} />
  </div>

  <!-- The floor -->
  <section class="floor container" aria-labelledby="floor-heading">
    <h2 id="floor-heading" class="floor__heading">The floor</h2>
    <p class="floor__intro">
      {SITE_NAME} is an arcade of original games, built to play as well on a phone as on a desk.
      {floorIntro}
    </p>

    <div class="floor__grid">
      <GameTile
        slug={featured.meta.slug}
        title={featured.meta.title}
        tagline={featured.meta.tagline}
        category={featured.meta.category}
        color={featured.color}
        comingSoon={featured.status === 'coming-soon'}
        featured
        class="floor__featured"
      />
      {
        rest.map((g) => (
          <GameTile
            slug={g.meta.slug}
            title={g.meta.title}
            tagline={g.meta.tagline}
            category={g.meta.category}
            color={g.color}
            comingSoon={g.status === 'coming-soon'}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
    padding-top: var(--sp-6);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .hero__screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    text-align: center;
    padding: var(--sp-4);
    width: 100%;
    height: 100%;
    background: radial-gradient(90% 80% at 50% 45%, rgba(77, 240, 208, 0.1), transparent 70%);
  }
  .hero__pitch {
    margin: 0;
    font-size: var(--fs-2);
    color: var(--ticket);
    max-width: 26ch;
  }
  @media (min-width: 900px) {
    .hero__pitch {
      font-size: var(--fs-3);
    }
    .hero__screen {
      padding: var(--sp-6);
      gap: var(--sp-3);
    }
  }
  .hero__note {
    margin: 0;
    font-size: var(--fs-0);
    color: var(--ticket-dim);
  }
  .hero__meta {
    font-size: var(--fs-0);
    color: var(--ticket-dim);
  }

  .daily {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    border-radius: var(--r-cabinet);
    border: var(--panel-border);
  }
  .daily__title {
    margin: 0;
    font-size: var(--fs-3);
  }
  .daily__sub {
    margin: 0;
    color: var(--ticket-dim);
    font-size: var(--fs-0);
  }
  .daily__streak {
    margin: 0;
    margin-top: var(--sp-2);
    color: var(--ticket-dim);
    font-size: var(--fs-0);
  }
  .daily__streak-num {
    font-family: var(--font-hud);
    font-size: var(--fs-2);
    color: var(--phosphor);
    text-shadow: var(--glow-phosphor);
    margin-left: var(--sp-1);
  }

  .floor {
    padding-top: var(--sp-7);
  }
  .floor__heading {
    margin-bottom: var(--sp-2);
  }
  .floor__intro {
    color: var(--ticket-dim);
    margin-bottom: var(--sp-5);
  }

  .floor__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  @media (min-width: 900px) {
    .floor__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* The class lands on GameTile's root (a child component), so target it globally
     but scoped under the grid so it can't leak. */
  .floor__grid :global(.floor__featured) {
    grid-column: span 2;
  }
</style>

<script>
  // Fill the daily panel with the live puzzle number and the viewer's streak.
  // Only tiny pure modules are imported here — never the word data — so the
  // homepage JS budget stays small.
  import { RUNGS_EPOCH } from '../config/site';
  import { dayIndex, sgDayNumber } from '../games/rungs/daily';
  import { createSave } from '../services/save';
  import { EMPTY_STATS, currentStreak, solvedToday, type Stats } from '../games/rungs/streaks';

  const panel = document.querySelector('[data-daily-panel]');
  if (panel) {
    const now = Date.now();
    const number = dayIndex(now, RUNGS_EPOCH) + 1;
    const today = sgDayNumber(now);
    const stats = createSave('rungs').get<Stats>('stats', EMPTY_STATS);

    const numEl = panel.querySelector('[data-rungs-number]');
    if (numEl) numEl.textContent = `Rungs #${number}`;
    const streakEl = panel.querySelector('[data-rungs-streak]');
    if (streakEl) streakEl.textContent = String(currentStreak(stats, today));
    const cta = panel.querySelector('[data-rungs-cta]');
    if (cta && solvedToday(stats, today)) cta.textContent = "See today's result";
  }
</script>
