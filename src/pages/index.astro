---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_TAGLINE } from '../config/site';
---

<BaseLayout>
  <main class="placeholder">
    <p class="boot" data-testid="boot">System ready</p>
    <h1 data-testid="site-name">{SITE_NAME}</h1>
    <p class="tagline">{SITE_TAGLINE}</p>
    <p class="note">Phase 0 is live. The arcade floor is under construction.</p>
  </main>
</BaseLayout>

<style>
  .placeholder {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .boot {
    margin: 0;
    color: var(--phosphor);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1.05;
  }

  .tagline {
    margin: 0;
    font-size: 1.125rem;
  }

  .note {
    margin-top: 1rem;
    color: var(--phosphor);
    opacity: 0.8;
  }
</style>
