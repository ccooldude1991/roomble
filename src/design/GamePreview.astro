---
/*
 * A live gameplay preview for a cabinet screen: a looping attract-mode clip over a
 * poster frame, generated by `npm run capture` (scripts/capture-previews.ts).
 *
 * Performance + reduced-motion rules (see CLAUDE.md / DESIGN.md):
 *   - The <video> uses preload="none" with data-src sources; nothing downloads until
 *     the clip is near the viewport (IntersectionObserver hydrates + plays it).
 *   - Off-screen clips are paused. Autoplay is muted + playsinline.
 *   - prefers-reduced-motion: the clip never loads; the static poster shows instead.
 *
 * If a game has no captured preview yet, the default slot renders instead (the
 * cabinet's placeholder). Put the preview inside a <CrtScreen>.
 */
import manifest from '../previews.manifest.json';

interface PreviewEntry {
  webm?: boolean;
  mp4?: boolean;
  poster?: boolean;
  og?: boolean;
  w: number;
  h: number;
}

interface Props {
  slug: string;
  /** Used for the poster alt text. */
  title: string;
}

const { slug, title } = Astro.props;
const entry = (manifest as Record<string, PreviewEntry>)[slug];
const hasPreview = !!entry && !!entry.poster && (!!entry.webm || !!entry.mp4);

const base = import.meta.env.BASE_URL;
const asset = (file: string) => `${base}previews/${file}`;
---

{
  hasPreview ? (
    <div class="preview" data-preview>
      <img
        class="preview__poster"
        src={asset(`${slug}.jpg`)}
        alt={`${title} gameplay`}
        width={entry!.w}
        height={entry!.h}
        loading="lazy"
        decoding="async"
      />
      <video
        class="preview__video"
        muted
        loop
        playsinline
        preload="none"
        poster={asset(`${slug}.jpg`)}
        width={entry!.w}
        height={entry!.h}
        aria-hidden="true"
        data-preview-video
      >
        {entry!.mp4 && <source data-src={asset(`${slug}.mp4`)} type="video/mp4" />}
        {entry!.webm && <source data-src={asset(`${slug}.webm`)} type="video/webm" />}
      </video>
    </div>
  ) : (
    <slot />
  )
}

<style>
  .preview {
    position: relative;
    width: 100%;
    height: 100%;
    background: #050208;
  }
  .preview__poster,
  .preview__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* The clip fades in over the poster once it starts playing. */
  .preview__video {
    opacity: 0;
    transition: opacity var(--t-base, 180ms) var(--ease-out, ease);
  }
  .preview__video[data-playing] {
    opacity: 1;
  }
  /* Reduced motion: never show the clip — the poster is the whole preview. */
  @media (prefers-reduced-motion: reduce) {
    .preview__video {
      display: none;
    }
  }
</style>

<script>
  // One controller for every preview clip on the page. Clips only download and play
  // while near the viewport, and pause when scrolled away — so a wall of cabinets
  // never loads a wall of video.
  const prefersReduced =
    typeof matchMedia !== 'undefined' && matchMedia('(prefers-reduced-motion: reduce)').matches;

  function hydrate(v: HTMLVideoElement): void {
    if (v.dataset.hydrated) return;
    v.dataset.hydrated = '1';
    for (const s of Array.from(v.querySelectorAll<HTMLSourceElement>('source[data-src]'))) {
      if (s.dataset.src) s.src = s.dataset.src;
    }
    v.load();
  }

  function setup(): void {
    if (prefersReduced) return; // posters only; nothing to animate
    const videos = Array.from(
      document.querySelectorAll<HTMLVideoElement>('video[data-preview-video]'),
    );
    if (videos.length === 0) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            hydrate(v);
            void v.play().catch(() => {});
            v.setAttribute('data-playing', '');
          } else {
            v.pause();
            v.removeAttribute('data-playing');
          }
        }
      },
      { threshold: 0.25 },
    );
    for (const v of videos) io.observe(v);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup, { once: true });
  } else {
    setup();
  }
</script>
