---
/*
 * Mute toggle. Reflects and persists the global audio mute via the audio service.
 * Renders both icons; CSS shows the right one based on [data-muted]. The initial
 * state is corrected on the client (mute is stored in localStorage).
 */
import Icon from './Icon.astro';
---

<button type="button" class="sound" data-sound-toggle aria-label="Sound on" aria-pressed="false">
  <span class="sound__on"><Icon name="sound-on" size={22} /></span>
  <span class="sound__off"><Icon name="sound-off" size={22} /></span>
</button>

<style>
  .sound {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55em;
    aspect-ratio: 1;
    color: var(--phosphor);
    background: var(--bezel);
    border: none;
    border-radius: var(--r-button);
    box-shadow: 0 4px 0 var(--bezel-edge);
    transition:
      transform var(--t-fast) var(--ease-out),
      box-shadow var(--t-fast) var(--ease-out);
  }
  .sound:active {
    transform: translateY(4px);
    box-shadow: 0 0 0 var(--bezel-edge);
  }
  .sound__off {
    display: none;
    color: var(--ticket-dim);
  }
  .sound[data-muted] .sound__on {
    display: none;
  }
  .sound[data-muted] .sound__off {
    display: inline-flex;
  }
  @media (prefers-reduced-motion: reduce) {
    .sound:active {
      transform: none;
    }
  }
</style>

<script>
  import { audio, SFX } from '../services/audio';

  function sync(btn: HTMLElement) {
    const muted = audio.isMuted();
    btn.toggleAttribute('data-muted', muted);
    btn.setAttribute('aria-pressed', String(muted));
    btn.setAttribute('aria-label', muted ? 'Sound off' : 'Sound on');
  }

  document.querySelectorAll<HTMLElement>('[data-sound-toggle]').forEach((btn) => {
    sync(btn);
    btn.addEventListener('click', () => {
      void audio.unlock();
      audio.setMuted(!audio.isMuted());
      sync(btn);
      if (!audio.isMuted()) audio.play(SFX.toggle);
    });
  });
</script>
